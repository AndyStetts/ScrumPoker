@page "/"
@inject RoomService RoomService
@inject NavigationManager Nav
@using ScrumPoker.Models
@using ScrumPoker.Services

<PageTitle>Scrum Poker</PageTitle>

<div class="home-container">
    <div class="home-hero">
        <picture class="asi-logo-hero">
            <source media="(prefers-color-scheme: dark)"  srcset="ASI_Logo_FullMark_RGB_Color_OnDark.png" />
            <source media="(prefers-color-scheme: light)" srcset="ASI_Logo_FullMark_RGB_Color_OnLight.png" />
            <img src="ASI_Logo_FullMark_RGB_Color_OnDark.png" alt="ASI Logo" />
        </picture>
        <h1><span>Scrum</span> Poker</h1>
        <p class="hero-subtitle">Estimate stories collaboratively, in real time.</p>
    </div>

    <div class="home-cards">
        <!-- Join Room -->
        <div class="home-card @(_activeTab == "join" ? "active" : "")" @onclick='() => _activeTab = "join"'>
            <div class="card-header">
                <span class="card-icon">🚪</span>
                <h2>Join a Room</h2>
            </div>

            @if (_activeTab == "join")
            {
                <div class="card-body">
                    <div class="form-group">
                        <label>Your Name</label>
                        <input class="form-control" @bind="_joinName" @bind:event="oninput"
                               placeholder="Enter your name" maxlength="30" />
                    </div>
                    <div class="form-group">
                        <label>Room Code</label>
                        <input class="form-control room-code-input"
                               value="@_joinCode"
                               placeholder="e.g. AB3X7K" maxlength="6"
                               @oninput="e => _joinCode = e.Value?.ToString()?.ToUpper() ?? string.Empty" />
                    </div>
                    @if (_joinError is not null)
                    {
                        <div class="alert alert-danger">@_joinError</div>
                    }
                    <button class="btn btn-secondary btn-lg w-100"
                            @onclick="JoinRoom" @onclick:stopPropagation
                            disabled="@(string.IsNullOrWhiteSpace(_joinName) || _joinCode.Length < 6)">
                        Join Room
                    </button>
                </div>
            }
        </div>

        <!-- Create Room -->
        <div class="home-card @(_activeTab == "create" ? "active" : "")" @onclick='() => _activeTab = "create"'>
            <div class="card-header">
                <span class="card-icon">✨</span>
                <h2>Create a Room</h2>
            </div>

            @if (_activeTab == "create")
            {
                <div class="card-body">
                    <div class="form-group">
                        <label>Your Name</label>
                        <input class="form-control" @bind="_createName" @bind:event="oninput"
                               placeholder="Enter your name" maxlength="30" />
                    </div>
                    <div class="form-group">
                        <label>Card Deck</label>
                        <div class="deck-options">
                            @foreach (var dt in Enum.GetValues<DeckType>())
                            {
                                <button class="deck-btn @(_selectedDeck == dt ? "selected" : "")"
                                        @onclick="() => SelectDeck(dt)" @onclick:stopPropagation>
                                    <span class="deck-name">@DeckLabel(dt)</span>
                                    <span class="deck-preview">@DeckPreview(dt)</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="customize-toggle-row">
                        <button type="button" class="btn-customize @(_showCustomize ? "active" : "")"
                                @onclick="() => _showCustomize = !_showCustomize" @onclick:stopPropagation>
                            ✏️ Customize cards
                        </button>
                    </div>

                    @if (_showCustomize)
                    {
                        <div class="form-group deck-customize">
                            <label>Select which cards to include <span class="customize-hint">· drag to reorder</span></label>
                            <div class="card-chips">
                                @foreach (var (card, idx) in _deckCards.Select((c, i) => (c, i)))
                                {
                                    var included = !_disabledCards.Contains(card);
                                    var i = idx;
                                    <button type="button"
                                            draggable="true"
                                            class="card-chip @(included ? "on" : "off") @(_dragIndex == i ? "chip-dragging" : "") @(_dragOverIndex == i ? "chip-drag-over" : "")"
                                            title="@(included ? "Click to exclude" : "Click to include")"
                                            @ondragstart="() => OnDragStart(i)"
                                            @ondragover="() => OnDragOver(i)" @ondragover:preventDefault="true"
                                            @ondrop="() => OnDrop(i)" @ondrop:preventDefault="true"
                                            @ondragend="OnDragEnd"
                                            @onclick="() => ToggleCard(card)" @onclick:stopPropagation>
                                        <span class="drag-handle">⠿</span>@card
                                    </button>
                                }
                            </div>
                            <div class="add-card-row">
                                <input class="form-control add-card-input"
                                       @bind="_newCardInput" @bind:event="oninput"
                                       placeholder="Add a card value…" maxlength="6"
                                       @onkeydown="OnAddCardKey" />
                                <button type="button" class="btn-add-card"
                                        @onclick="AddCard" @onclick:stopPropagation
                                        disabled="@(string.IsNullOrWhiteSpace(_newCardInput))">
                                    + Add
                                </button>
                            </div>
                            @if (_enabledCardCount == 0)
                            {
                                <div class="customize-warning">Select at least one card.</div>
                            }
                        </div>
                    }
                    @if (_createError is not null)
                    {
                        <div class="alert alert-danger">@_createError</div>
                    }
                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="CreateRoom" @onclick:stopPropagation
                            disabled="@(string.IsNullOrWhiteSpace(_createName))">
                        Create Room
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _activeTab = "join";
    private string _createName = string.Empty;
    private DeckType _selectedDeck = DeckType.Fibonacci;
    private List<string> _deckCards = CardDeck.Fibonacci().Cards.ToList();
    private HashSet<string> _disabledCards = [];
    private string _newCardInput = string.Empty;
    private bool _showCustomize = false;
    private int? _dragIndex;
    private int? _dragOverIndex;
    private string? _createError;

    private string _joinName = string.Empty;
    private string _joinCode = string.Empty;
    private string? _joinError;

    private int _enabledCardCount => _deckCards.Count(c => !_disabledCards.Contains(c));

    private void SelectDeck(DeckType dt)
    {
        _selectedDeck = dt;
        _deckCards = CardDeck.FromDeckType(dt).Cards.ToList();
        _disabledCards = [];
        _newCardInput = string.Empty;
        _showCustomize = false;
    }

    private void ToggleCard(string card)
    {
        if (!_disabledCards.Add(card))
            _disabledCards.Remove(card);
    }

    private void AddCard()
    {
        var value = _newCardInput.Trim();
        if (string.IsNullOrEmpty(value)) return;
        if (!_deckCards.Contains(value))
        {
            _deckCards.Add(value);
            _disabledCards.Remove(value);
            SortDeckCards();
        }
        _newCardInput = string.Empty;
    }

    private void SortDeckCards()
    {
        var numbers = _deckCards
            .Where(c => double.TryParse(c, out _))
            .OrderBy(double.Parse)
            .ToList();
        var nonNumbers = _deckCards
            .Where(c => !double.TryParse(c, out _))
            .ToList();
        _deckCards = [.. numbers, .. nonNumbers];
    }

    private void OnDragStart(int index)
    {
        _dragIndex = index;
        _dragOverIndex = null;
    }

    private void OnDragOver(int index)
    {
        if (_dragIndex is null || _dragIndex == index) return;
        _dragOverIndex = index;
    }

    private void OnDrop(int targetIndex)
    {
        _dragOverIndex = null;
        if (_dragIndex is null || _dragIndex.Value == targetIndex)
        {
            _dragIndex = null;
            return;
        }

        var fromIdx = _dragIndex.Value;
        var card = _deckCards[fromIdx];
        _deckCards.RemoveAt(fromIdx);
        var insertAt = targetIndex > fromIdx ? targetIndex - 1 : targetIndex;
        _deckCards.Insert(insertAt, card);
        _dragIndex = null;
    }

    private void OnDragEnd()
    {
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private void OnAddCardKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCard();
    }

    private void CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(_createName))
        {
            _createError = "Please enter your name.";
            return;
        }
        if (_enabledCardCount == 0)
        {
            _createError = "Select at least one card for the deck.";
            return;
        }

        var deck = new CardDeck
        {
            Type = _selectedDeck,
            Name = DeckLabel(_selectedDeck),
            Cards = _deckCards.Where(c => !_disabledCards.Contains(c)).ToList()
        };
        var (room, participant) = RoomService.CreateRoom(_createName.Trim(), deck);
        Nav.NavigateTo($"/room/{room.Code}?pid={participant.Id}");
    }

    private void JoinRoom()
    {
        if (string.IsNullOrWhiteSpace(_joinName))
        {
            _joinError = "Please enter your name.";
            return;
        }
        if (_joinCode.Length != 6)
        {
            _joinError = "Room code must be 6 characters.";
            return;
        }

        var existing = RoomService.GetRoom(_joinCode.ToUpper());
        if (existing is null)
        {
            _joinError = $"Room \"{_joinCode.ToUpper()}\" not found. Check the code and try again.";
            return;
        }
        if (existing.Participants.Count >= 30)
        {
            _joinError = "This room is full (30 participants maximum).";
            return;
        }

        var result = RoomService.JoinRoom(_joinCode.ToUpper(), _joinName.Trim());
        if (result is null)
        {
            _joinError = $"Room \"{_joinCode.ToUpper()}\" not found. Check the code and try again.";
            return;
        }

        var (room, participant) = result.Value;
        Nav.NavigateTo($"/room/{room.Code}?pid={participant.Id}");
    }

    private static string DeckLabel(DeckType dt) => dt switch
    {
        DeckType.Fibonacci => "Fibonacci",
        DeckType.TShirt => "T-Shirt Sizes",
        DeckType.PowersOfTwo => "Powers of 2",
        _ => dt.ToString()
    };

    private static string DeckPreview(DeckType dt) => dt switch
    {
        DeckType.Fibonacci => "1, 2, 3, 5, 8, 13…",
        DeckType.TShirt => "XS, S, M, L, XL…",
        DeckType.PowersOfTwo => "1, 2, 4, 8, 16…",
        _ => string.Empty
    };
}
