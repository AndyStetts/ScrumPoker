@page "/room/{Code}"
@implements IDisposable
@inject RoomService RoomService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ScrumPoker.Services
@using PokerRoom = ScrumPoker.Models.Room
@using ScrumPoker.Models

<PageTitle>Room @Code | Scrum Poker</PageTitle>

@if (_room is null)
{
    <div class="not-found">
        <h2>Room not found</h2>
        <p>The room <strong>@Code</strong> doesn't exist or has expired.</p>
        <a class="btn btn-primary" href="/">Back to Home</a>
    </div>
}
else if (_me is null)
{
    <div class="join-prompt">
        <h2>Join Room <span class="room-code-badge">@Code</span></h2>
        <div class="form-group">
            <label>Your Name</label>
            <input class="form-control" @bind="_nameInput" @bind:event="oninput"
                   placeholder="Enter your name" maxlength="30"
                   @onkeydown="@(e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_nameInput)) JoinAsLateParticipant(); })" />
        </div>
        @if (_joinError is not null)
        {
            <div class="alert alert-danger">@_joinError</div>
        }
        <button class="btn btn-primary btn-lg" @onclick="JoinAsLateParticipant"
                disabled="@string.IsNullOrWhiteSpace(_nameInput)">
            Join Room
        </button>
    </div>
}
else
{
    <div class="room-layout">
        <!-- Header -->
        <header class="room-header">
            <div class="room-header-left">
                <a href="/" class="btn-back">← Home</a>
                <a href="/" class="asi-logo-header">
                    <picture>
                        <source media="(prefers-color-scheme: dark)"  srcset="ASI_Logo_FullMark_RGB_Color_OnDark.png" />
                        <source media="(prefers-color-scheme: light)" srcset="ASI_Logo_FullMark_RGB_Color_OnLight.png" />
                        <img src="ASI_Logo_FullMark_RGB_Color_OnDark.png" alt="ASI Logo" />
                    </picture>
                </a>
            </div>
            <div class="room-header-center">
                <div class="room-share-row">
                    <span class="room-code-label">Join Link:</span>
                    <span class="room-code-badge room-url-badge">@_joinUrl</span>
                    <button class="btn-copy" title="Copy join message" @onclick="CopyUrl">📋</button>
                    @if (_copiedUrl) { <span class="copy-feedback">Copied!</span> }
                </div>
                <div class="room-share-row">
                    <span class="room-code-label">Room Code:</span>
                    <span class="room-code-badge">@_room.Code</span>
                    <button class="btn-copy" title="Copy room code" @onclick="CopyCode">📋</button>
                    @if (_copiedCode) { <span class="copy-feedback">Copied!</span> }
                </div>
            </div>
            <div class="room-header-right">
                <span class="deck-badge">@_room.Deck.Name</span>
                <span class="participant-count">👥 @_room.Participants.Count</span>
            </div>
        </header>

        @if (_notification is not null)
        {
            <div class="host-transfer-banner">
                <span class="host-transfer-icon">👑</span>
                @_notification
            </div>
        }

        <div class="room-body">
            <!-- Left panel: Stories -->
            <aside class="panel-stories @(_mobileTab == "stories" ? "mobile-active" : "")">
                <div class="panel-header">
                    <h3>Stories</h3>
                    @if (_isHost)
                    {
                        <button class="btn-icon" title="Add story" @onclick="() => _showAddStory = !_showAddStory">＋</button>
                    }
                </div>

                @if (_isHost && _showAddStory)
                {
                    <div class="add-story-form">
                        <input class="form-control" @bind="_newStoryTitle" @bind:event="oninput"
                               placeholder="Story title or ticket…" @onkeydown="OnAddStoryKey" />
                        <button class="btn btn-primary btn-sm" @onclick="AddStory"
                                disabled="@string.IsNullOrWhiteSpace(_newStoryTitle)">Add</button>
                    </div>
                }

                <ul class="story-list">
                    @foreach (var story in _room.Stories)
                    {
                        <li class="story-item @(story.Id == _room.CurrentStoryId ? "current" : "") @(story.IsComplete ? "complete" : "") @(_isHost ? "host-clickable" : "")"
                            @onclick="() => SelectStory(story.Id)">
                            <div class="story-item-inner">
                                <span class="story-title">@story.Title</span>
                                @if (story.IsComplete && story.FinalEstimate is not null)
                                {
                                    <span class="story-estimate">@story.FinalEstimate</span>
                                }
                                else if (story.Id == _room.CurrentStoryId)
                                {
                                    <span class="story-active-dot"></span>
                                }
                            </div>
                            @if (_isHost)
                            {
                                <button class="btn-remove" title="Remove story"
                                        @onclick="() => RemoveStory(story.Id)" @onclick:stopPropagation>✕</button>
                            }
                        </li>
                    }
                    @if (!_room.Stories.Any())
                    {
                        <li class="story-empty">No stories yet.@(_isHost ? " Add one above." : "")</li>
                    }
                </ul>
            </aside>

            <!-- Center: Voting area -->
            <main class="panel-voting @(_mobileTab == "vote" ? "mobile-active" : "")">
                @if (_room.CurrentStory is null)
                {
                    <div class="no-story">
                        <div class="no-story-icon">📋</div>
                        <p>@(_isHost ? "Add a story from the left panel to start estimating." : "Waiting for the host to select a story…")</p>
                    </div>
                }
                else
                {
                    <div class="current-story-card">
                        <div class="current-story-label">Estimating</div>
                        <div class="current-story-title">@_room.CurrentStory.Title</div>
                    </div>

                    <!-- Vote status bar -->
                    <div class="vote-status">
                        @{
                            var voted = _room.Participants.Count(p => p.HasVoted);
                            var total = _room.Participants.Count;
                        }
                        <span>@voted / @total voted</span>
                        @if (_room.AllVoted && !_room.VotesRevealed && _isHost)
                        {
                            <span class="all-voted-hint">Everyone has voted!</span>
                        }
                    </div>

                    <!-- Participant votes (revealed) or hidden cards -->
                    <div class="votes-grid">
                        @foreach (var p in _room.Participants)
                        {
                            <div class="vote-card-wrapper">
                                <div class="vote-card @(p.HasVoted ? "voted" : "") @(_room.VotesRevealed ? "revealed" : "")">
                                    @if (_room.VotesRevealed && p.HasVoted)
                                    {
                                        <span class="vote-value">@p.CurrentVote</span>
                                    }
                                    else if (p.HasVoted)
                                    {
                                        <span class="vote-hidden">✓</span>
                                    }
                                    else
                                    {
                                        <span class="vote-waiting">…</span>
                                    }
                                </div>
                                <span class="voter-name @(p.Id == _me.Id ? "me" : "")">
                                    @p.Name@(p.IsHost ? " 👑" : "")
                                </span>
                            </div>
                        }
                    </div>

                    <!-- Vote results summary -->
                    @if (_room.VotesRevealed)
                    {
                        var allGroups = _room.Participants
                            .Where(p => p.HasVoted)
                            .GroupBy(p => p.CurrentVote!)
                            .Select(g => new { Vote = g.Key, Count = g.Count(), Names = g.Select(p => p.Name).ToList() })
                            .OrderByDescending(x => x.Count)
                            .ThenBy(x => x.Vote)
                            .ToList();
                        var nonCoffeeGroups = allGroups.Where(g => g.Vote != "☕").ToList();
                        var isConsensus = nonCoffeeGroups.Count == 1;

                        if (allGroups.Any())
                        {
                            <div class="vote-results">
                                @if (isConsensus)
                                {
                                    <div class="results-banner consensus-banner">✓ Consensus reached: <strong>@nonCoffeeGroups[0].Vote</strong></div>
                                }
                                else if (nonCoffeeGroups.Count > 1)
                                {
                                    <div class="results-banner no-consensus-banner">↺ No consensus — team discussion and re-vote required</div>
                                }
                                <div class="results-groups">
                                    @foreach (var g in allGroups)
                                    {
                                        <div class="result-group @(isConsensus && g.Vote != "☕" ? "consensus-vote" : "")"
                                             data-tooltip="@string.Join(", ", g.Names)">
                                            <div class="result-card">@g.Vote</div>
                                            <div class="result-count">@g.Count @(g.Count == 1 ? "vote" : "votes")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Card deck (for voting) -->
                    @if (!_room.VotesRevealed)
                    {
                        <div class="deck-area">
                            <p class="deck-label">@(_me.HasVoted ? "Change your vote:" : "Pick a card:")</p>
                            <div class="deck-cards">
                                @foreach (var card in _room.Deck.Cards)
                                {
                                    <button class="playing-card @(_me.CurrentVote == card ? "selected" : "")"
                                            @onclick="() => CastVote(card)">
                                        @card
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!-- Host controls -->
                    @if (_isHost)
                    {
                        <div class="host-controls">
                            @if (!_room.VotesRevealed)
                            {
                                <button class="btn btn-reveal"
                                        @onclick="RevealVotes"
                                        disabled="@(!_room.Participants.Any(p => p.HasVoted && !p.IsHost))">
                                    Reveal Votes
                                </button>
                            }
                            else
                            {
                                <div class="reveal-actions">
                                    <div class="final-estimate-row">
                                        <label>Final Estimate:</label>
                                        <div class="estimate-options">
                                            @foreach (var card in _room.Deck.Cards.Where(c => c != "☕"))
                                            {
                                                <button class="est-btn @(_selectedEstimate == card ? "selected" : "")"
                                                        @onclick="() => _selectedEstimate = card">
                                                    @card
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="reveal-buttons">
                                        <button class="btn btn-success"
                                                @onclick="AcceptEstimate"
                                                disabled="@(_selectedEstimate is null)">
                                            ✓ Accept
                                        </button>
                                        <button class="btn btn-outline" @onclick="ResetVotes">
                                            ↺ Re-vote
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (_room.VotesRevealed)
                    {
                        <div class="waiting-host">Waiting for host to finalize estimate…</div>
                    }
                }
            </main>

            <!-- Right panel: Participants -->
            <aside class="panel-participants @(_mobileTab == "players" ? "mobile-active" : "")">
                <div class="panel-header">
                    <h3>Participants</h3>
                </div>
                <ul class="participant-list">
                    @foreach (var p in _room.Participants)
                    {
                        var canTransfer = _isHost && !p.IsHost && p.Id != _me.Id;
                        <li class="participant-item @(canTransfer ? "can-transfer" : "")"
                            @onmouseenter="() => { if (canTransfer) _focusedParticipantId = p.Id; }"
                            @onmouseleave="() => { if (_focusedParticipantId == p.Id) _focusedParticipantId = null; }"
                            @onclick="() => { if (canTransfer) _focusedParticipantId = (_focusedParticipantId == p.Id ? null : p.Id); }">
                            <div class="participant-avatar">@p.Name[0].ToString().ToUpper()</div>
                            <div class="participant-info">
                                <span class="participant-name">
                                    @p.Name
                                    @if (p.IsHost) { <span class="host-badge">Host</span> }
                                    @if (p.Id == _me.Id) { <span class="you-badge">You</span> }
                                </span>
                                <span class="participant-status">
                                    @if (_room.VotesRevealed && p.HasVoted)
                                    {
                                        <span class="vote-revealed-badge">@p.CurrentVote</span>
                                    }
                                    else if (p.HasVoted)
                                    {
                                        <span class="voted-badge">Voted ✓</span>
                                    }
                                    else if (!_room.VotesRevealed)
                                    {
                                        <span class="waiting-badge">Waiting…</span>
                                    }
                                </span>
                            </div>
                            @if (canTransfer && _focusedParticipantId == p.Id)
                            {
                                <button class="btn-transfer-host" title="Make host"
                                        @onclick="() => DoTransferHost(p.Id)" @onclick:stopPropagation>
                                    👑 Make Host
                                </button>
                            }
                        </li>
                    }
                </ul>
            </aside>
        </div>

        <!-- Mobile tab bar -->
        <nav class="mobile-tab-bar">
            <button class="mobile-tab @(_mobileTab == "stories" ? "active" : "")" @onclick='() => _mobileTab = "stories"'>
                <span class="mobile-tab-icon">📋</span>
                <span class="mobile-tab-label">Stories</span>
            </button>
            <button class="mobile-tab @(_mobileTab == "vote" ? "active" : "")" @onclick='() => _mobileTab = "vote"'>
                <span class="mobile-tab-icon">🃏</span>
                <span class="mobile-tab-label">Vote</span>
            </button>
            <button class="mobile-tab @(_mobileTab == "players" ? "active" : "")" @onclick='() => _mobileTab = "players"'>
                <span class="mobile-tab-icon">👥</span>
                <span class="mobile-tab-label">Players</span>
            </button>
        </nav>
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "pid")] public string? ParticipantId { get; set; }

    private PokerRoom? _room;
    private Participant? _me;
    private bool _isHost;

    private string _mobileTab = "vote";
    private string? _focusedParticipantId;
    private string? _notification;
    private string? _shownNotification;

    private bool _showAddStory;
    private string _newStoryTitle = string.Empty;
    private string? _selectedEstimate;
    private bool _copiedUrl;
    private bool _copiedCode;
    private string _origin = string.Empty;
    private string _joinUrl => string.IsNullOrEmpty(_origin) ? $"/room/{Code}" : $"{_origin}/room/{Code}";
    private string _nameInput = string.Empty;

    private Func<Task>? _subscription;

    protected override void OnInitialized()
    {
        _room = RoomService.GetRoom(Code);
        if (_room is null) return;

        if (ParticipantId is not null)
            _me = _room.Participants.FirstOrDefault(p => p.Id == ParticipantId);

        _isHost = _me?.IsHost ?? false;

        _subscription = async () => await InvokeAsync(async () =>
        {
            _room = RoomService.GetRoom(Code);
            if (_room is not null && _me is not null)
            {
                _me = _room.Participants.FirstOrDefault(p => p.Id == _me.Id);
                _isHost = _me?.IsHost ?? false;
            }

            var msg = _room?.HostTransferMessage;
            if (msg is not null && msg != _shownNotification)
            {
                _shownNotification = msg;
                _notification = msg;
                StateHasChanged();
                await Task.Delay(5000);
                _notification = null;
            }

            StateHasChanged();
        });

        RoomService.Subscribe(Code.ToUpper(), _subscription);
    }

    private string? _joinError;

    private void JoinAsLateParticipant()
    {
        if (string.IsNullOrWhiteSpace(_nameInput) || _room is null) return;
        if (_room.Participants.Count >= 30)
        {
            _joinError = "This room is full (30 participants maximum).";
            return;
        }
        var result = RoomService.JoinRoom(Code, _nameInput.Trim());
        if (result is null) return;
        (_room, _me) = result.Value;
        _isHost = _me.IsHost;
        Nav.NavigateTo($"/room/{Code}?pid={_me.Id}", replace: true);
    }

    private void CastVote(string card)
    {
        if (_me is null || _room is null) return;
        RoomService.Vote(Code.ToUpper(), _me.Id, card);
    }

    private void RevealVotes()
    {
        if (_me is null) return;
        RoomService.RevealVotes(Code.ToUpper(), _me.Id);
        // Auto-select the most common vote so Accept is immediately usable
        _selectedEstimate = _room?.Participants
            .Where(p => p.CurrentVote is not null && p.CurrentVote != "☕")
            .GroupBy(p => p.CurrentVote!)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .FirstOrDefault()?.Key;
    }

    private void ResetVotes()
    {
        if (_me is null) return;
        _selectedEstimate = null;
        RoomService.ResetVotes(Code.ToUpper(), _me.Id);
    }

    private void AcceptEstimate()
    {
        if (_me is null || _selectedEstimate is null || _room?.CurrentStory is null) return;
        RoomService.SetFinalEstimate(Code.ToUpper(), _me.Id, _room.CurrentStory.Id, _selectedEstimate);
        _selectedEstimate = null;

        // Auto-advance to next incomplete story
        var next = _room.Stories.FirstOrDefault(s => !s.IsComplete && s.Id != _room.CurrentStoryId);
        if (next is not null)
            RoomService.SetCurrentStory(Code.ToUpper(), _me.Id, next.Id);
        else
            RoomService.ResetVotes(Code.ToUpper(), _me.Id);
    }

    private void AddStory()
    {
        if (_me is null || string.IsNullOrWhiteSpace(_newStoryTitle)) return;
        var story = RoomService.AddStory(Code.ToUpper(), _me.Id, _newStoryTitle.Trim());
        if (story is null) return;
        RoomService.SetCurrentStory(Code.ToUpper(), _me.Id, story.Id);
        _selectedEstimate = null;
        _newStoryTitle = string.Empty;
        _showAddStory = false;
    }

    private void OnAddStoryKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddStory();
    }

    private void RemoveStory(string storyId)
    {
        if (_me is null) return;
        RoomService.RemoveStory(Code.ToUpper(), _me.Id, storyId);
    }

    private void DoTransferHost(string participantId)
    {
        if (_me is null) return;
        RoomService.TransferHost(Code.ToUpper(), _me.Id, participantId);
        _focusedParticipantId = null;
    }

    private void SelectStory(string storyId)
    {
        if (_me is null || !_isHost || storyId == _room?.CurrentStoryId) return;
        _selectedEstimate = null;
        RoomService.SetCurrentStory(Code.ToUpper(), _me.Id, storyId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _origin = await JS.InvokeAsync<string>("getOrigin");
            StateHasChanged();
        }
    }

    private async Task CopyUrl()
    {
        await JS.InvokeVoidAsync("copyText", _joinUrl);
        _copiedUrl = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedUrl = false;
        StateHasChanged();
    }

    private async Task CopyCode()
    {
        await JS.InvokeVoidAsync("copyText", Code);
        _copiedCode = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedCode = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_subscription is not null)
            RoomService.Unsubscribe(Code.ToUpper(), _subscription);

        if (_me is not null && _room is not null)
            RoomService.LeaveRoom(Code.ToUpper(), _me.Id);
    }
}
